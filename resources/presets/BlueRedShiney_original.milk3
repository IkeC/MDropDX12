{
  "version": 1,
  "shadertoy": true,
  "name": "BlueRedShiney_original",
  "image": "#define tx (sin(time)*0.5+1)\n\n#define T (sin(_c2.x*.6)*16.+_c2.x*1e2)\n#define P(z) (float3(cos((z)*.011)*16.+cos((z) * .012)  *24., cos((z)*.01)*4., (z)))\n#define R(a) float2x2(cos(a+float4(0,33,11,0)))\n#define N normalize\n\nfloat boxen(float3 p) {\n\n  p = abs(frac(p/2e1)*2e1 - 1e1) - 1.;\n  return min(p.x, min(p.y, p.z));\n\n}\n\nfloat4 lights = 0;\nfloat map(float3 p) {\n  float3 q = P(p.z);\n  float m, g = q.y-p.y + 6.;\n\n  m = boxen(p);\n\n  p.xy -= q.xy;\n\n  float red = 0,blue = 0;\n  float e = min(red=length(p.xy -  sin(p.z / 12. + float2(0, 1.3))*12.) - 1.,\n  blue=length(p.xy -  sin(p.z / 16. + float2(0, .7))*16.) - 2.);  \n\n  lights += float4(1e1,2,1,0)/(.1+abs(red));\n  lights += float4(1,2,1e1,0)/(.1+abs(blue)/1e1);;\n\n  p = abs(p);\n\n  float tex = abs(length(sin(p*cos(p.yzx/3e1)*4.)/(p*4.)));     \n  float tun = min(32.-p.x - p.y, 24.-p.y);\n\n  float d = max(min(m, g), tun)-tex;\n  return min(e, d);\n}\n\nshader_body {\n  float4 o = 0;\n  float2 u = uv * texsize.xy;\n  #undef uv\n  #undef uv_orig\n  #undef mouse\n  #undef mouse_x\n  #undef mouse_y\n  #undef mouse_pos\n  #undef mouse_clicked\n\n  float i = 0,s = 0,d = 0;\n  float3  r = float3(texsize.x, texsize.y, 1.0);\n\n  u = (u-r.xy/2.)/r.y;\n\n  u.y -=.2;    \n  o = float4(0, 0, 0, 0);\n  float3  p = P(T),ro=p,\n  Z = N( P(T+2.) - p),\n  X = N(float3(Z.z, 0, (-Z).x)),\n  D = N(mul(float3x3(-X, cross(X, Z), Z), float3(mul(u, R(sin(T*.005)*.4)), 1)));\n\n  for(; i++ < 1e2;)\n  p = ro + D * d,\n  d += s = map(p)*.8,\n  o += lights + 1./max(s, .01);\n\n  const float h = 0.005;\n  const float2 k = float2(1,-1);\n  float3 n = N(k.xyy*map( p + k.xyy*h ) + \n  k.yyx*map( p + k.yyx*h ) + \n  k.yxy*map( p + k.yxy*h ) + \n  k.xxx*map( p + k.xxx*h ) );\n\n  o *= (.1 + max(dot(n, -D), 0.));\n\n  float4 ref = 0;\n  lights = float4(0, 0, 0, 0);\n  for(p += n*.05, D = reflect(D, n), s=i=0.; i++<5e1; )\n  p += D*s,\n  s = map(p)*.8,\n  ref +=  lights + 1./max(s, .01);\n\n  o += o*ref;\n  o = tanh(o / 1e9 * exp(float4(1e1,2,1,0)*d/5e2));\n  ret = o;\n}\n",
  "channels": {
    "image": {
      "iChannel0": "self"
    }
  }
}
