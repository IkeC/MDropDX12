{
  "version": 1,
  "shadertoy": true,
  "name": "BlueRedShiney_smooth",
  "notes": {
    "image": "Smoother BlueRedShiney: ~3.5x slower flythrough, gentler path wobble/roll, fewer ray steps for steadier frame times, softer surface detail + glow (less temporal sparkle), light temporal blend via self-feedback."
  },
  "image": "// SMOOTH — BlueRedShiney with reduced stutter\n// - T: time*100 -> time*28, gentler sin path\n// - roll amplitude / frequency reduced\n// - primary 72 / reflection 28 (was 100 / 50)\n// - softer SDF texture + glow poles\n// - light temporal blend via sampler_feedback\n\n#define T (sin(_c2.x * 0.22) * 6.0 + _c2.x * 28.0)\n#define P(z) (float3(cos((z) * 0.011) * 16.0 + cos((z) * 0.012) * 24.0, cos((z) * 0.01) * 4.0, (z)))\n#define R(a) float2x2(cos(a + float4(0, 33, 11, 0)))\n#define N normalize\n\nfloat boxen(float3 p)\n{\n  p = abs(frac(p / 2e1) * 2e1 - 1e1) - 1.0;\n  return min(p.x, min(p.y, p.z));\n}\n\nfloat4 lights = 0;\nfloat map(float3 p)\n{\n  float3 q = P(p.z);\n  float m, g = q.y - p.y + 6.0;\n\n  m = boxen(p);\n  p.xy -= q.xy;\n\n  float red = 0.0, blue = 0.0;\n  float e = min(\n    red  = length(p.xy - sin(p.z / 12.0 + float2(0.0, 1.3)) * 12.0) - 1.0,\n    blue = length(p.xy - sin(p.z / 16.0 + float2(0.0, 0.7)) * 16.0) - 2.0\n  );\n\n  // Softer 1/r poles -> less frame-to-frame flicker near tubes\n  lights += float4(1e1, 2.0, 1.0, 0.0) / (0.18 + abs(red));\n  lights += float4(1.0, 2.0, 1e1, 0.0) / (0.18 + abs(blue) / 1e1);\n\n  p = abs(p);\n\n  // Lower spatial frequency + scale on surface detail (was *4 / full strength)\n  float tex = abs(length(sin(p * cos(p.yzx / 3e1) * 2.4) / (p * 4.0))) * 0.65;\n  float tun = min(32.0 - p.x - p.y, 24.0 - p.y);\n\n  float d = max(min(m, g), tun) - tex;\n  return min(e, d);\n}\n\nshader_body\n{\n  float4 o = 0;\n  float2 uv_fb = uv;\n  float2 u = uv * texsize.xy;\n  #undef uv\n  #undef uv_orig\n  #undef mouse\n  #undef mouse_x\n  #undef mouse_y\n  #undef mouse_pos\n  #undef mouse_clicked\n\n  float i = 0.0, s = 0.0, d = 0.0;\n  float3 r = float3(texsize.x, texsize.y, 1.0);\n\n  u = (u - r.xy * 0.5) / r.y;\n  u.y -= 0.2;\n  o = float4(0, 0, 0, 0);\n  lights = float4(0, 0, 0, 0);\n\n  float3 p = P(T), ro = p,\n    Z = N(P(T + 2.0) - p),\n    X = N(float3(Z.z, 0.0, (-Z).x)),\n    // Gentler roll: was sin(T*.005)*.4\n    D = N(mul(float3x3(-X, cross(X, Z), Z), float3(mul(u, R(sin(T * 0.0025) * 0.18)), 1.0)));\n\n  // Fixed step counts (no early-out) for steadier GPU frame cost\n  for (; i++ < 72.0;)\n  {\n    p = ro + D * d;\n    // Slightly conservative step + soft clamp reduces overshoot flicker\n    s = map(p) * 0.75;\n    d += min(max(s, 0.01), 2.5);\n    o += lights + 1.0 / max(s, 0.02);\n  }\n\n  const float h = 0.006;\n  const float2 k = float2(1.0, -1.0);\n  float3 n = N(\n    k.xyy * map(p + k.xyy * h) +\n    k.yyx * map(p + k.yyx * h) +\n    k.yxy * map(p + k.yxy * h) +\n    k.xxx * map(p + k.xxx * h)\n  );\n\n  o *= (0.1 + max(dot(n, -D), 0.0));\n\n  float4 ref = 0;\n  lights = float4(0, 0, 0, 0);\n  for (p += n * 0.05, D = reflect(D, n), s = i = 0.0; i++ < 28.0;)\n  {\n    p += D * s;\n    s = map(p) * 0.75;\n    ref += lights + 1.0 / max(s, 0.02);\n  }\n\n  o += o * ref;\n  o = tanh(o / 1e9 * exp(float4(1e1, 2.0, 1.0, 0.0) * d / 5e2));\n\n  // Light temporal blend smooths residual motion/aliasing\n  float4 prev = tex2D(sampler_feedback, uv_fb);\n  float blend = (frame < 2.0) ? 0.0 : 0.18;\n  o = lerp(o, prev, blend);\n\n  ret = o;\n}\n",
  "channels": {
    "image": {
      "iChannel0": "self"
    }
  }
}
