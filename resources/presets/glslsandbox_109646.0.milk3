  "image": "//Made by Jordan Duty(AKA djdduty) May 14, 2014.\n#define ptpi 1385.4557313670110891409199368797 //powten(pi)\n#define pipi  36.462159692 //pi pied, pi^pi\n#define picu  31.006276680299820175476315067101 //pi cubed, pi^3\n#define pepi  23.140692632779269005729086367949 //powe(pi);\n#define chpi  11.59195327552152062775175205256  //cosh(pi)\n#define shpi  11.548739357257748377977334315388 //sinh(pi)\n#define pisq  9.8696044010893586188344909998762 //pi squared, pi^2\n#define twpi  6.2831853075286766559  //two pi, 2*pi \n#define pi    3.1415926535897932384626433832795 //pi\n#define sqpi  1.7724538509055160272981674833411 //square root of pi \n#define hfpi  1.5707963267948966192313216916398 //half pi, 1/pi\n#define cupi  1.4645918875615232630201425272638 //cube root of pi\n#define prpi  1.4396194958475906883364908049738 //pi root of pi\n#define lnpi  1.1447298858494001741434273513531 //logn(pi); \n#define trpi  1.0471975511965977461542144610932 //one third of pi, pi/3\n#define thpi  0.99627207622074994426469058001254//tanh(pi)\n#define lgpi  0.4971498726941338543512682882909 //log(pi)       \n#define rcpi  0.31830988618379067153776752674503// reciprocal of pi  , 1/pi  \n#define rcpipi  0.0274256931232981061195562708591 // reciprocal of pipi  , 1/pipi\n#define useFractal fractal2Color\n\n//universeFractal from http://glsl.heroku.com/e#16703\n#define iterations 10\n#define formuparam 0.42\n\n#define volsteps 10\n#define stepsize 0.120\n\n#define zoom   0.1000\n#define tile   0.1120\n#define speed  0.00100\n\n#define brightness 0.001\n#define darkmatter 0.500\n#define distfading 0.120\n#define saturation -0.900\n\n\nfloat3 universeFractal(float2 surfacePos) {\n\t//get coords and direction\n\tfloat2 uvn =surfacePos;\n\tfloat3 dir=float3(uvn*zoom,10.);\n\t\n\tfloat a2=time/10.0*speed;\n\tfloat a1=10.0;\n\tfloat2x2 rot1=float2x2(cos(a1),sin(a1),-sin(a1),cos(a1));\n\tfloat2x2 rot2=rot1;\n\tdir.xz = mul(dir.xz, rot1);\n\tdir.xy = mul(dir.xy, rot2);\n\t\n\t//mouse movement\n\tfloat3 from=((float3)(0.));\n\tfrom+=float3(.001*time,.001*time,-2.);\n\t\n\t//from.x-=mouse.x;\n\t//from.y-=mouse.y;\n\t\n\tfrom.xz = mul(from.xz, rot1);\n\tfrom.xy = mul(from.xy, rot2);\n\t\n\t//volumetric rendering\n\tfloat s=.4,fade=.2;\n\tfloat3 v=((float3)(0.4));\n\tfor (int r=0; r<volsteps; r++) {\n\t\tfloat3 p=from+s*dir*.5;\n\t\tp = abs(((float3)(tile))-fmod(p,((float3)(tile*2.)))); // tiling fold\n\t\tfloat pa,a=pa=0.;\n\t\tfor (int i=0; i<iterations; i++) { \n\t\t\tp=abs(p)/dot(p,p)-1.1*formuparam; // the magic formula\n\t\t\ta+=abs(length(p)-pa); // absolute sum of average change\n\t\t\tpa=length(p);\n\t\t}\n\t\tfloat dm=max(0.,darkmatter-a*a*.001); //dark matter\n\t\ta*=a*a*2.; // add contrast\n\t\tif (r>3) fade*=1.-dm; // dark matter, don't render near\n\t\tv+=fade;\n\t\tv+=float3(s,s*s,s*s*s*s)*a*brightness*fade; // coloring based on distance\n\t\tfade*=distfading; // distance fading\n\t\ts+=stepsize;\n\t}\n\tv=lerp(((float3)(length(v))),v,saturation); //color adjust\n\treturn ((float3)(v * .01));\t\n\n}\n\n//other fractal2 from http://glsl.heroku.com/e#16840\n#define fractal_details 10\n#define zoomout 1.0\n\nfloat3 fractal2Color(float2 surfacePos) {\n\n\tfloat2 p = surfacePos*zoomout;//*sin(time*0.5)*10.5;\n\tfloat3 c = ((float3)(0));\n\tfloat2 fractal;\n\tfloat deepfade = 1.0;\n\tfor (int i=-0; i<fractal_details; i++) \n\t{\n\t\t//deepfade -= float(i)/float(fractal_details);\n\t\tdeepfade *= 0.5;\n\t\tfractal = abs(p)/dot(p,p)-1.0+sin(time*0.5)*0.5;\n\t\tfloat2 pdiff = fractal-p;\n\t\tfloat ddiff = abs(length(pdiff));\n\t\t//c.rg += fractal*deepfade;\n\t\tc.rg += pdiff*deepfade;\n\t\tc.b += ddiff*deepfade;\n\t\tp = fractal;\n\t}\n\treturn ((c));\n}\n\n//scene with spheres\nstruct Ray\n{\n\tfloat3 Dir;\n\tfloat3 Pos;\n};\n\t\nstruct Sphere\n{\n\tfloat3 Pos;\n\tfloat3 Color;\n\tfloat Rad;\n\tfloat Reflection;\n};\n\nstatic const int numSpheres = 7;\nstatic Sphere spheres[numSpheres];\n\nstatic float3 LightPos = float3(0,-3,10);\n\t\nfloat3 Intersects(Sphere s, Ray r)\n{\n\tfloat t0, t1;\n\tfloat3 l = s.Pos - r.Pos;\n\tfloat tca = dot(l, r.Dir);\n\tif(tca < 0.0) return float3(0,0,-1.0);\n\tfloat d2 = dot(l, l) - tca*tca;\n\tif(d2 > s.Rad*s.Rad) return float3(0,0,-1.0);\n\tfloat thc = sqrt((s.Rad*s.Rad) - d2);\n\treturn float3(tca-thc, tca+thc, 1);\n}\n\t\nfloat mix2(float a, float b, float c)\n{\n\treturn b*c+a*(1.0-c);\t\n}\n\nfloat3 Trace3(Ray r)\n{\n\tfloat3 Color = ((float3)(0));\n\tSphere s;\n\tbool col = false;\n\tfloat tnear = 1e8;\n\tfor(int i = 0; i < numSpheres; i++)\n\t{\n\t\tfloat3 intTest = Intersects(spheres[i],r);\n\t\tif(intTest.z != -1.0) {\n\t\t\tif(intTest.x < tnear) {\n\t\t\t\ttnear = intTest.x;\n\t\t\t\ts = spheres[i];\n\t\t\t\tcol = true;\n\t\t\t}\n\t\t}\n\t}\n\tif(col==false) return ((float3)(0));\n\tfloat3 phit = r.Pos + r.Dir * tnear;        float spaceScale = 0.1;       Color+=(useFractal(phit.xy*spaceScale)+useFractal(phit.xz*spaceScale)+useFractal(phit.yz*spaceScale))/3.0;\n\tfloat3 nhit = phit - s.Pos;\n\tnhit = normalize(nhit);\n\tfloat bias = 1e-4;\n\t\n\tfloat3 lightDir = LightPos - phit;\n\tbool blocked = false;\n\tlightDir = normalize(lightDir);\n\tfloat DiffuseFactor = dot(nhit, lightDir);\n\tfloat3 diffuseColor = ((float3)(0));\n\tfloat3 ambientColor = ((float3)(s.Color * 0.2));\n\t\n\tfor(int n = 0; n < numSpheres; n++)\n\t{\n\t\tRay rl;\n\t\trl.Pos = phit;\n\t\trl.Dir = lightDir;\n\t\tfloat3 intTestL = Intersects(spheres[n],rl); \n\t\tif(intTestL.z != -1.0)\n\t\t{\n\t\t\tif(intTestL.x < length(LightPos-phit)) {\n\t\t\t\tblocked = true;\t\n\t\t\t}\n\t\t}\n\t}\n\t\n\tif(!blocked)\n\t{\n\t\tif(DiffuseFactor > 0.0)\n\t\t{\n\t\t\tdiffuseColor = \t((float3)(1))*DiffuseFactor;\n\t\t\tColor += s.Color*diffuseColor + ambientColor;\n\n\t\t}\n\t\telse\n\t\t{\n\t\t\tColor+=ambientColor;\t\n\t\t}\n\t} \n\telse\n\t{\n\t\tColor+=ambientColor;\n\t}\n\t\n\treturn Color;\n}\n\nfloat3 Trace2(Ray r)\n{\n\tfloat3 Color = ((float3)(0));\n\tSphere s;\n\tbool col = false;\n\tfloat tnear = 1e8;\n\tfor(int i = 0; i < numSpheres; i++)\n\t{\n\t\tfloat3 intTest = Intersects(spheres[i],r);\n\t\tif(intTest.z != -1.0) {\n\t\t\tif(intTest.x < tnear) {\n\t\t\t\ttnear = intTest.x;\n\t\t\t\ts = spheres[i];\n\t\t\t\tcol = true;\n\t\t\t}\n\t\t}\n\t}\n\tif(col==false) return ((float3)(0));\n\tfloat3 phit = r.Pos + r.Dir * tnear;\n\tfloat3 nhit = phit - s.Pos;\n\tnhit = normalize(nhit);\n\tfloat bias = 1e-4;\n\t\n\tbool inside = false;\n\tif(dot(r.Dir, nhit) > 0.0) { nhit *= -1.0; inside = true; }\n\t\n\tif(s.Reflection > 0.0)\n\t{\n\t\tfloat facingratio = dot((r.Dir*-1.0), nhit);\n\t\tfloat3 refldir = r.Dir - nhit * 2.0 * dot(r.Dir, nhit);\n\t\trefldir = normalize(refldir);\n\t\tRay rd;\n\t\trd.Pos = phit;\n\t\trd.Dir = refldir;\n\t\tfloat3 refl = Trace3(rd);\n\t\tfloat param1 = (1.0-s.Reflection);\n\t\tfloat param2 = s.Reflection;\n\t\tColor.x = (param1 * Color.x + param2 * refl.x);\n\t\tColor.y = (param1 * Color.y + param2 * refl.y);\n\t\tColor.z = (param1 * Color.z + param2 * refl.z);\n\t}\n\t\n\tfloat3 lightDir = LightPos - phit;\n\tbool blocked = false;\n\tlightDir = normalize(lightDir);\n\tfloat DiffuseFactor = dot(nhit, lightDir);\n\tfloat3 diffuseColor = ((float3)(0));\n\tfloat3 ambientColor = ((float3)(s.Color * 0.2));\n\t\n\tfor(int n = 0; n < numSpheres; n++)\n\t{\n\t\tRay rl;\n\t\trl.Pos = phit;\n\t\trl.Dir = lightDir;\n\t\tfloat3 intTestL = Intersects(spheres[n],rl); \n\t\tif(intTestL.z != -1.0)\n\t\t{\n\t\t\tif(intTestL.x < length(LightPos-phit))\n\t\t\t\tblocked = true;\t\n\t\t}\n\t}\n\t\n\tif(!blocked)\n\t{\n\t\tif(DiffuseFactor > 0.0)\n\t\t{\n\t\t\tdiffuseColor = \t((float3)(1))*DiffuseFactor;\n\t\t\tColor += s.Color*diffuseColor + ambientColor;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tColor+=ambientColor;\t\n\t\t}\n\t} \n\telse\n\t{\n\t\tColor+=ambientColor;\n\t}\n\t\n\t\n\treturn Color;\n}\n\nfloat3 spuke(float3 pos)\n{\n\tfloat2 p   =((pos.z)+(sin((((length(sin((pos.xy)+pos.z*pi)))+(cos((pos.z*pi)/pi)))))))+pos.xy*pos.z; \n\tfloat3 col = ((float3)(0.0));\n\tfloat ca = 0.0;\n\tfor( int j = 1; j < 8; j++ )\n\t{\n\t\tp *= 1.4;\n\t\tfloat jj = float( j );\n\t\t\n\t\tfor( int i = 1; i <8; i++ )  \n\t\t{\n\t\t\tfloat2 newp = p*0.96;\n\t\t\tfloat ii = float( i );\n\t\t\tnewp.x += 1.2 / ( ii + jj ) * sin( ii * p.y + (p.x*.3) + cos(pos.z/pi/pi)*pi*pi + 0.003 * ( jj / ii ) ) + 1.0;\n\t\t\tnewp.y += 0.8 / ( ii + jj ) * cos( ii * p.x + (p.y*.3) + sin(pos.z/pi/pi)*pi*pi + 0.003 * ( jj / ii ) ) - 1.0;\n\t\t\tp=newp;\n\t\t\t\n\t\t\n\t\t}\n\t\tp   *= 0.9;\n\t\tcol += float3( 0.5 * sin( pi * p.x ) + 0.5, 0.5 * sin( pi * p.y ) + 0.5, 0.5 * sin( pi * p.x ) * cos( pi * p.y ) + 0.5 )*(0.5*sin(pos.z*pi)+0.5);\n\t\tca  += 0.7;\n\t}\n\tcol /= ca;\n\treturn ((float3)(col * col * col));\n}\nfloat3 Trace(Ray r)\n{\n\tfloat3 Color = ((float3)(0));\n\tSphere s;\n\tbool col = false;\n\tfloat tnear = 1e8;\n\tfor(int i = 0; i < numSpheres; i++)\n\t{\n\t\tfloat3 intTest = Intersects(spheres[i],r);\n\t\tif(intTest.z != -1.0) {\n\t\t\tif(intTest.x < tnear) {\n\t\t\t\ttnear = intTest.x;\n\t\t\t\ts = spheres[i];\n\t\t\t\tcol = true;\n\t\t\t}\n\t\t}\n\t}\n\tif(col==false) return ((float3)(0));\n\tfloat3 phit = r.Pos + r.Dir * tnear;\n\tfloat3 nhit = phit - s.Pos;\n\tnhit = normalize(nhit);\n\tfloat bias = 1e-4;\n\t\n\tbool inside = false;\n\tif(dot(r.Dir, nhit) > 0.0) { nhit *= -1.0; inside = true; }\n\t\n\tif(s.Reflection > 0.0)\n\t{\n\t\tfloat facingratio = dot((r.Dir*-1.0), nhit);\n\t\tfloat3 refldir = r.Dir - nhit * 2.0 * dot(r.Dir, nhit);\n\t\trefldir = normalize(refldir);\n\t\tRay rd;\n\t\trd.Pos = phit;\n\t\trd.Dir = refldir;\n\t\tfloat3 refl = Trace2(rd);\n\t\tfloat param1 = (1.0-s.Reflection);\n\t\tfloat param2 = s.Reflection;\n\t\tColor.x = (param1 * Color.x + param2 * refl.x);\n\t\tColor.y = (param1 * Color.y + param2 * refl.y);\n\t\tColor.z = (param1 * Color.z + param2 * refl.z);\n\t}\n\t\n\tfloat3 lightDir = LightPos - phit;\n\tbool blocked = false;\n\tlightDir = normalize(lightDir);\n\tfloat DiffuseFactor = dot(nhit, lightDir);\n\tfloat3 diffuseColor = ((float3)(0));\n\tfloat3 ambientColor = ((float3)(s.Color * 0.2));\n\t\n\tfor(int n = 0; n < numSpheres; n++)\n\t{\n\t\tRay rl;\n\t\trl.Pos = phit;\n\t\trl.Dir = lightDir;\n\t\tfloat3 intTestL = Intersects(spheres[n],rl); \n\t\tif(intTestL.z != -1.0)\n\t\t{\n\t\t\tif(intTestL.x < length(LightPos-phit))\n\t\t\t\tblocked = true;\t\n\t\t}\n\t}\n\t\n\tif(!blocked)\n\t{\n\t\tif(DiffuseFactor > 0.0)\n\t\t{\n\t\t\tdiffuseColor = \t((float3)(1))*DiffuseFactor;\n\t\t\tColor += s.Color*diffuseColor + ambientColor;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tColor+=ambientColor;\t\n\t\t}\n\t\t\n\t} \n\telse\n\t{\n\t\tColor+=ambientColor;\n\t}\n\t\n\t\n\treturn lerp(Color,spuke(Color*pi),0.5+sin(time/pi)*0.25);\n}\n\nshader_body {\n  // GLSL Sandbox mouse is 0..1, y=0 at bottom; milk3 mouse is pixels, y=0 at top\n  float2 _sb_mouse = float2(mouse.x * texsize.z, mouse.y * texsize.w);\n\tspheres[0].Pos = float3(5,0,-0);\n\tspheres[0].Color = ((float3)(1.0));\n\tspheres[0].Rad = 4.0;\n\tspheres[0].Reflection = 0.4;\n\t\n\tspheres[1].Pos = float3(-5,0,-0);\n\tspheres[1].Color = ((float3)(0.0));\n\tspheres[1].Rad = 4.0;\n\tspheres[1].Reflection = 0.3;\n\t//floor\n\tspheres[2].Pos = float3(-5,1004,-0);\n\tspheres[2].Color = ((float3)(0.0));\n\tspheres[2].Rad = 1000.0;\n\tspheres[2].Reflection = 0.5;\n\t//sides\n\tspheres[3].Pos = float3(-5,0,-1040);\n\tspheres[3].Color = float3(0.9,0.0,0.0);\n\tspheres[3].Rad = 1000.0;\n\tspheres[3].Reflection = 0.505;\n\t\n\tspheres[4].Pos = float3(1020,0,-0);\n\tspheres[4].Color = float3(0.0,0.9,0.0);\n\tspheres[4].Rad = 1000.0;\n\tspheres[4].Reflection = 0.505;\n\t\n\tspheres[5].Pos = float3(-1020,0,-0);\n\tspheres[5].Color = float3(0.0,0.0,0.7);\n\tspheres[5].Rad = 1000.0;\n\tspheres[5].Reflection = 0.505;\n\t\n\tspheres[6].Pos = float3(-5,0,1040);\n\tspheres[6].Color = float3(0.9,0.9,0.0);\n\tspheres[6].Rad = 1000.0;\n\tspheres[6].Reflection = 0.505;\n\t\n\tfloat invWidth = 1.0 / texsize.x;\n\tfloat invHeight = 1.0 / texsize.y;\n\tfloat fov = 60.0; \n\tfloat aspectratio = texsize.x/texsize.y;\n\tfloat angle = tan(pi * 0.5 * fov / 180.0);\n\t\n\t//float3 sinTime = ((float3)(sin(time*2.0)));\n\t\n\tfloat3 camTrans = float3(20.0*cos(0.5*time), 0, 20.0*sin(0.5*time));\n\tfloat3 camDir = camTrans - ((float3)(0));\n\t\n\tcamTrans.y = -5.0;\n\tLightPos.y = -10.0;//camTrans;\n\t\n\tfloat3x3 rot;\n\tfloat3 f = normalize(camTrans);\n\tfloat3 u = float3(0,1,0);\n\tfloat3 s = normalize(cross(f,u));\n\tu = cross(s,f);\n\trot[0][0] = s.x; rot[1][0] = s.y; rot[2][0] = s.z;\n\trot[0][1] = u.x; rot[1][1] = u.y; rot[2][1] = u.z;\n\trot[0][2] = f.x; rot[1][2] = f.y; rot[2][2] = f.z;\n\t\n\tRay R;\n\tfloat xx = (2.0 *(((uv * texsize.xy).x+0.5) * invWidth) -1.0)*angle*aspectratio;\n\tfloat yy = (1.0-2.0*(((uv * texsize.xy).y+0.5)*invHeight))*angle;\t\n\tR.Pos = camTrans;\n\tR.Dir = mul(float3(xx,yy,-1), rot);\n\tR.Dir = normalize(R.Dir);\n\t\n\tret = float4((Trace(R)), 1.0);\n}\n"
}
