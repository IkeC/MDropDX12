{
  "version": 1,
  "shadertoy": true,
  "name": "jdDwSvWJsa",
  "channels": {
    "image": {
      "iChannel0": "self"
    }
  },
  "image": "// Aya Tunnel by Martijn Steinrucken aka BigWings - 2019\n// countfrolic@gmail.com\n// License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License.\n// \n//\n// Inspired by a vision I had during an ayahuasca ceremony.\n// This is a 'sweetend up' version of the tunnel I felt I was flying through.\n//\n// This is just 3 octaves of gyroids\n// First two layers are intersected, next two are mixed.\n//\n\n// Music: Asura - Crossroads Limiter\n// https://soundcloud.com/licoknigi-1/asura-crossroads-limiter\n\n\n#define SURF_DIST .0001\n#define MAX_DIST 100.\n#define MAX_STEPS 400\n\n// use these to tweak the effect\n//#define KALEIDOSCOPE\n#define PERLESCENCE\n//#define SHADOW\n\nstatic float3 lightPos;\n\nfloat smin( float a, float b, float k )\n{\n    float h = clamp( 0.5+0.5*(b-a)/k, 0.0, 1.0 );\n    return lerp( b, a, h ) - k*h*(1.0-h);\n}\n\nfloat GetHeight(float depth) {\n\treturn 1.5-sin(depth*.5);\n}\n\nfloat3 GetRayDir(float2 puv, float3 ro, float3 lookat, float3 up, float zoom) {\n    float3 f = normalize(lookat-ro),\n        r = normalize(cross(up, f)),\n        u = cross(f, r),\n        c = ro + f*zoom,\n        i = c + puv.x*r + puv.y*u,\n        rd = normalize(i-ro);\n    return rd;\n}\n\nfloat LineDist(float3 p, float3 a, float3 b) {\n\tfloat3 ba = a-b,\n        pa = a-p;\n    \n    return length(cross(ba, pa))/length(ba);\n}\n\nfloat2x2 Rot(float a) {\n    float s = sin(a), c = cos(a);\n    return float2x2(c, -s, s, c);\n}\n\nfloat GetDist(float3 p) {\n\tfloat2 m = mouse.xy/texsize.xy - .5;\n\n   float lightDist = length(p-lightPos);\n    \n    p.z += time;\n    float z = p.z*.5;\n     \n    p.y += sin(z);\n    \n    \n    float a = smoothstep(0.,3., lightDist);\n    float w = lerp(-1., 1., sqrt(a));\n    float d = (abs(dot(sin(p), cos(p.zxy)))-.1*w);\n    \n    float s = 5.;\n    p.x += time*.2;\n    \n    float second = (abs(dot(sin(p*s), cos(p.zxy*s)))-w)/s;\n    \n    s = 8.;\n    float second2 = (abs(dot(sin(p*s), cos(p.zxy*s)))-w)/s;\n    \n    second = lerp(second, second2, sin(z*.2)*.5+.5);\n    \n    d = smin(d, second,-.1);\n    \n    \n    m.y=sin(p.z*.345)*.5-.2;\n    s = 26.2;\n    float third = (abs(dot(sin(p*s), cos(p.zxy*s)))-.1)/s;\n    d = lerp(d, third, m.y);\n    \n    return d*.25;\n}\n\nfloat3 GetNormal(float3 p) {\n    float2 e = float2(.01, 0);\n    float3 n = GetDist(p) - float3(\n        GetDist(p-e.xyy),\n        GetDist(p-e.yxy),\n        GetDist(p-e.yyx)\n    );\n    \n    return normalize(n);\n}\n\nfloat4 CastRay(float3 ro, float3 rd) {\n    float dS = 0.0, dO = 0.0;\n    float3 p;\n    for(int i=0; i<MAX_STEPS; i++) {\n    \tp = ro + dO * rd;\n        dS = GetDist(p);\n        dO += dS;\n        \n        if(dS<SURF_DIST || dO>MAX_DIST) break;\n    }\n    \n    return float4(p, dS);\n}\n\nshader_body {\n\n    float2 uvn = ((uv * texsize.xy)-.5*texsize.xy)/texsize.y;\n    float2 UV = uvn;\n    float3 col = float3(0, 0, 0);\n\t\n    float t = time;\n    float pulse = sin(t*.2)<-0.5?1.:0.;\n    float2 m = mouse.xy/texsize.xy;\n    \n    #ifdef KALEIDOSCOPE\n    uvn /= dot(uvn,uvn)*2.;\n    uvn = abs(uvn);\n    float kaleidoscope = smoothstep(.4, .6, sin(-t*.2));\n    //uvn = lerp(UV, uvn, kaleidoscope);\n    #endif\n    \n    float z = t*.5;\n    \n    float zoom = 1.;\n    float3 up = float3(sin(t*.2),cos(t*.2),0);\n    float3 ro = float3(0, GetHeight(t), 0);\n    float3 lookat = float3(0,GetHeight(t+.5),1);\n    float3 rd = GetRayDir(uvn, ro, lookat, up, zoom);\n    float lightDepth = 7.+sin(t*.162-2.)*3.;\n    lightPos = float3(0,GetHeight(t+lightDepth),lightDepth);\n\n    \n    float4 hit = CastRay(ro, rd);\n    float3 p = hit.xyz;\n    float dS = hit.w;\n    float dO = length(ro-p);\n    \n    \n    float3 glowCol = sin(float3(.123, .234, .345)*t)*.5+.85;\n    col = glowCol;\n    \n    float3 L = lightPos-p;\t// vec from surface to light\n    float ld = length(L);\t// distance from surface to light\n\n\n    float3 n = GetNormal(p);\n\n    float3 l = L/ld;\n\n    float dif = clamp(dot(n,l), 0., 1.);\n    float att = 1./ld;\n\n    float trust = smoothstep(.8, 1., sin(t))*.6+.4;\n    //trust = 1.;\n\n    col = dif*att*trust*glowCol*40.;\n    col *= dif*att*trust;\n\n    float spec = clamp(dot(reflect(rd, n), l),0.,1.);\n    spec = pow(spec, 20.);\n    col += spec*trust*att;\n\n    /*col=1.-col;\ncol *= .23;\ncol *= float3(.8,.7,.9);*/\n\n    if(length(lightPos-ro)<dO) {\n        float minLd = LineDist(lightPos, ro, ro+rd); \n        float3 light = glowCol*trust*.25/minLd;\n        col += light;\n    }\n    col *= smoothstep(5., 6.5, t);\n\n    #ifdef SHADOW\n    float4 shadow = CastRay(lightPos, -l);\n    if(abs(length(shadow.xyz-lightPos)-ld) > SURF_DIST) {\n        col *= .05;\n    }\n    #endif\n\n    float fogPhase = sin(t*.1);\n    fogPhase *= fogPhase*fogPhase;\n\n    col = lerp(col, glowCol, fogPhase*length(hit.xyz-ro)/20.);\n\n    #ifdef PERLESCENCE\n    float3 perl = n*.5+.5;\n    perl*=perl;\n    pulse = pow(sin(-ld*.4+t)*.5+.5,106.);\n\n    perl = sin(perl*t*.005)*.5+.5;\n    float3 perlCol = pulse*perl*lerp(glowCol,float3(1, 1, 1), 2.75);\n\n    pulse = sin(t*-.12)*.5+.5;\n    pulse = pulse*pulse;\n    //col = lerp(col, perlCol, pulse);\n\n    col += perlCol*pulse;\n    #endif\n\n\n   \n  // if(UV.x>m.x*1.77-.5)col = 1.-col;\n   \n    #ifdef KALEIDOSCOPE\n    col *= 1.+kaleidoscope;\n    \n    #endif\n    col = pow(col, float3(sin(t*.123)*.5+1.5, sin(t*.123)*.5+1.5, sin(t*.123)*.5+1.5));\n    ret = float4(col,1.0);\n}\n"
}
