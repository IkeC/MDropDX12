  "image": "// GLSL-compatible mod (floor-based; HLSL fmod differs for negatives)\nfloat  mod_glsl(float  x, float  y) { return x - y * floor(x / y); }\nfloat2 mod_glsl(float2 x, float2 y) { return x - y * floor(x / y); }\nfloat3 mod_glsl(float3 x, float3 y) { return x - y * floor(x / y); }\nfloat4 mod_glsl(float4 x, float4 y) { return x - y * floor(x / y); }\nfloat2 mod_glsl(float2 x, float  y) { return x - y * floor(x / y); }\nfloat3 mod_glsl(float3 x, float  y) { return x - y * floor(x / y); }\nfloat4 mod_glsl(float4 x, float  y) { return x - y * floor(x / y); }\n\n// milk3 clock capture (user redefines #define time ...)\n#define _sb_clock _c2.x\nstatic const float PI = 3.1415926;\nstatic const float TAU = PI * 2.0;\n\n#define now (frac(1e-5*_sb_clock)*2.0-1.0)\n#define otime now\n//*cos(now/PI+now*cos(now/TAU+PI*cos(now/2.20))*TAU)\n#define rtime now*TAU\n\n//cos(PI-otime*otime)*TAU\n\n//#define rtime ((((uv * texsize.xy).y * texsize.x + (uv * texsize.xy).x) * otime)/(texsize.x*texsize.y))\n//+dot(surfacePosition,surfacePosition.yx))\n//#define time ((mod_glsl(abs(rtime)/TAU,2.0)-1.0)*sign(otime))\n#define time rtime\n//#define time ((mod_glsl((rtime)*TAU,2.0)-1.0))\n//#define time (surfaceSize.x*surfaceSize.y)\n//#define time (rtime*dot(surfacePosition,surfacePosition))\n//#define time (mod_glsl(otime*TAU/32.0,2.0)-1.0)\n//#define time TAU/262144.0\n//#define time 1.0/PI*PI*PI\n//#define time 1.0/(TAU+rtime+dot(surfaceSize*texsize.xy/2.0,mouse*(uv * texsize.xy)))\n//#define toffset ((((uv * texsize.xy).y * texsize.x + (uv * texsize.xy).x))/(texsize.x*texsize.y))\n//(TAU+rtime+dot(surfacePosition,surfacePosition.yx))\n#define toffset (((uv * texsize.xy).y * texsize.x + (uv * texsize.xy).x))\n#define tarea (texsize.x*texsize.y)\n\n//#define what ((float2)(1e-3))*(1.0+surfacePosition/surfaceSize))\n\n//#define time (((what.x*what.y))*length(float2(rtime,1.-rtime)))\n//#define time (distance(float2(rtime,1.-rtime),(1.0-mouse.yx)*(1.0+surfacePosition.xy*surfaceSize.yx)))\n\n//(dot(surfacePosition,surfacePosition))\n//cos(rtime*toffset/tarea)\n//cos(PI*rtime)\n//rtime/(TAU+toffset*tarea))\n//+toffset))\n//(rtime)\n\n\n#define vt normalize(float2(time,1.0-time))\n#define cc(x) smoothstep(float2(-TAU,PI),float2(PI,TAU),cos((x-TAU)/(TAU-x*x)))\n//#define cc(x) cos(x)*cos(x*x)\n#define surfacePosition (uv * texsize.xy)*sin(_sb_surfPos)\n//cc(float2(-surfacePosition.y,surfacePosition.x)*surfacePosition)\n//#define surfacePosition (cc(1.0+vt*cc(float2(-surfacePosition.y,surfacePosition.x))))\n//#define mouse pow(2.0+mouse*TAU*TAU,(((mouse-0.5)*TAU)*cc(1.0+vt+surfaceSize)))\n//#define mouse (cc(vt)*normalize(cc(mouse-0.5)*TAU))\n\n// --------------------------------------------------------------------------------\n// https://en.wikipedia.org/wiki/Lissajous_curve\n\nfloat2 Lissajous(float a, float b, float o, float t )\n{\n\treturn float2( sin( a * t + o ), sin( b * t ) );\n}\n\n// --------------------------------------------------------------------------------\n// via https://www.shadertoy.com/view/stySWz to\n// http://marcodiiga.github.io/radial-lens-undistortion-filtering\nfloat2 barrelDistort(float2 p, float2 alpha) {\n    return p / (1.0 - alpha * dot(p, p));\n}\n\n// --------------------------------------------------------------------------------\n// https://en.wikipedia.org/wiki/Stereographic_projection\n\nfloat3 c2sA(float2 p)\n{\n\tfloat2 p2 = p * p;\n\tfloat md = (1.0 + p2.x + p2.y);\n\treturn float3( p.xy / md, (-1.0 + p2.x + p2.y) / (2.0 * md) );\n}\n\nfloat2 s2cA(float3 p)\n{\n\treturn p.xy / (0.5 - p.z);\n}\n\nfloat3 c2sB(float2 p)\n{\n\tfloat2 p2 = p * p;\n\tfloat omd = 1.0 / (1.0 + p2.x + p2.y);\n\treturn float3( 2.0 * p.xy, (-1.0 + p2.x + p2.y) ) * omd;\n\t\n}\n\nfloat2 s2cB(float3 p)\n{\n\treturn p.xy / (77.0 - p.z);\n}\n\n// --------------------------------------------------------------------------------\n\nfloat q2(float t)\n{\n\treturn t * TAU; //1.0 / (3.0 * t - 2.0 * t * t); //((t/(1.0-t*t*t)));// * exp((1.0/t*t));//sin(t/(TAU*TAU)); // - 1.0/(1.0 + t * t);\n}\n\nfloat q(float2 a,float2 b)\n{\n\treturn q2( dot(a,b) );\n}\n\nfloat q(float3 a,float3 b)\n{\n\treturn q2( dot(a,b) );\n}\n\nfloat3 c2s(float2 p)\n{\n\tfloat3 a = c2sA(p), b = c2sB(p);\n\t\n\tfloat t = q(a,b);\n\t\n\treturn lerp( a, b, t );\n}\n\nfloat2 s2c(float3 p)\n{\n\tfloat2 a = s2cA(p), b = s2cB(p);\n\t\n\tfloat t = q(a,b);\n\t\n\treturn lerp( a, b, t );\n}\n\n\n// --------------------------------------------------------------------------------\n\nfloat f(float t)\n{\n\treturn log(abs(t));\n}\n\nfloat2 f(float2 t)\n{\n\treturn log(abs(t));\n}\n\nfloat3 f(float3 t)\n{\n\treturn log(abs(t));\n}\n\nfloat3 f2(float3 a,float3 b,float t)\n{\n\tfloat w = t;\n\treturn lerp(a*b,a/b,w);\n\t//return lerp(b/a,a/b,w);\n}\n\n// --------------------------------------------------------------------------------\n\nfloat3 fn( float2 p, float2 sp, float2 m, float t )\n{\n\tfloat dp = t/dot(sp-p,p+sp);\n\t\n#if 0\n\tfloat md = t - dot(sp-m,m-p) - dp;\n\tfloat2 l = float2( sin(md), cos(md) );\n\tsp -= m * l;\n\tp -= m * (77.0 - l);\n#endif\n\t\n\tfloat3 a = c2s( sp );\n\tfloat3 b = c2s( p );\n\t\n\t//if ( 0.5 < (t) )\n#if 0\n\t{\n\t\ta *= b;\n\t\tb /= a;\n\t}\n#endif\n\n#if 0\n\tfloat3 s = f2( a, b, t );\n#else\n\tfloat3 s = a - b * t; \n\ts -= f2( a, b, t );\n#endif\n\t\n#if 1\n\tfloat q = TAU/dot(s,s);\n\tm *= q + dp+(TAU*TAU);\n\tm = abs(m/(TAU*TAU));\n#endif\n\t\n\t\n\ts.xy = mul(s.xy, float2x2( cos(m.y), -sin(m.y), sin(m.y), cos(m.y) ));\n\ts.yz = mul(s.yz, float2x2( cos(m.x), -sin(m.x), sin(m.x), cos(m.x) ));\n\tfloat4 o = float4(s,1.0);\n\t\n\tfloat2 puv = (s2c(o.xyz));//*s.xyz));\n\t\n#if 1\n\to.xyz = (float3(f(puv*sp),f(dot(o,1.0-o))));\n#else\n\to.xyz = (float3(f(puv*sp),f(dot(o,1.0-o)-dot(puv,1.0-puv))));\n#endif\n\t\n\t\n\to.xyz = (o.xyz);\n\t\n\t//o.xyz *= o.xyz / dot(o,o);\n\t\n\treturn o.xyz;\n}\n\nfloat3 g(float3 a,float3 b,float t)\n{\n\tif ( dot(a,b) < t ) return a - b;\n\t\n\treturn a * b;\n}\n\nfloat3 whatisinsideapixel(float2 p,float2 sp,float2 m,float2 puv,float t)\n{\n\tt = cos(t*TAU); // * exp(TAU * -t);\n\tm = (m * 2.0 - 46.0) * t;\n\t\n\tfloat3 a = fn(p,sp,m,t);\n\tfloat3 b = fn(sp.yx,(p.yx),m.yx,t);\n\t\n\tfloat3 e = g(a,b,dot(a-b,b-a));\n\t//float3 e = g(a,b,t*dot(a-b,b-a));\n\treturn e;\n}\n\n\nfloat3 whatisoutsideapixel(float2 p,float2 sp,float2 m,float2 puv,float t)\n{\n\t\n#if 0\n\t//m *= barrelDistort( m, ((float2)(dot(p,sp-p.yx))) );\n\tm *= barrelDistort( m, ((float2)(dot(p,puv/sp))) );\n#endif\n\t\n#if 0\n\t//float2 mx=max(puv.xx,puv.yy);\n\t//float2 mn=min(puv.xx,puv.yy);\n\tfloat2 bt = t-(p*sp);//m.xy;//((float2)(1.0/TAU));//\n\t//bt = ( (mouse * 2.0 - 1.0) * (((float2)(mx)) + ((float2)(mn)) * abs(cos(TAU/(1.0-t*t)))) );\n\tp = barrelDistort( p, bt );\n\tsp = barrelDistort( sp, bt );\n#endif\n\t\n//\tsp = log(abs(sp));\n//\tsp = (1.0 - sp*sp) / (1.0 + sp*sp);\n\n\t\n\t//p *= length((mouse * 2.0 - 1.0) / dot(sp,sp));\n\t\n\tfloat3 next = ((float3)(0.0));\n\n#if 1\n\t\n\t//p += texsize.xy*cos(p/TAU+cos(sp/TAU));\n\t//p *= texsize.xy*cos(sp*TAU+TAU*cos(sp*TAU));\n\t\n\tnext += whatisinsideapixel(p,sp,m,puv,t);\n\t\n#else\n\t\n\tfloat s = 1.0/256.0; //(surfaceSize.y*surfaceSize.x)/256.0;//max( (surfaceSize.y/surfaceSize.x), (texsize.y/texsize.x) ) / 256.0;\n\t\n\tfor ( float y = -1.0; y <= 1.0; y++ )\n\t{\n\t\tfor ( float x = -1.0; x <= 1.0; x++ )\n\t\t{\n\t\t\tfloat2 c = float2(x,y);\n\t\t\tfloat2 e = c*s;\n\t\t\tnext += whatisinsideapixel(p+e,sp,m*e,puv,t);\n\t\t}\n\t}\n\t\n\t//next = pow( next/9.0, ((float3)(1.0/2.2)) );\n\t\n#endif\n\t\n\n#if 1\n\t//next = ((float3)(cos(TAU*normalize(next))));\n\tnext = normalize(next);\n\t//next = abs(next);\n\t//next *= next;\n\t\n\t//next *= next * next;\n\t\n\t//next = pow( abs(next), ((float3)(-2.0/3.0)) );\n\t\n\t//next = pow((next),((float3)(3.0)));\n\t\n\t//for ( int i = 0; i < 3; i++ ) next *= max(next.x,max(next.y,next.z));\n\t\n#endif\n\t\n\t//next = fwidth(next);\n\t//next = frac(next+t);\n\t//next += fwidth(next)*next;\n\t//next = pow( next, ((float3)(1.0/2.2)) );\n\t\n\t//next = abs(next);\n\t\n\t//if ( mouse.x > 0.5 ||sin(t) < 0.0 )\n\t//next *= next;\n\t\n#if 0\n\tif ( 0.0 > (next.x*next.y*next.z) )\n\t{\n\t\tnext = frac(abs(next));\n\t}\n#endif\n\t\n#if 1\n\t//next = abs( sin(next) * cos(TAU*next-next) );\n\tnext = frac(next);\n#else\n\tif ( mouse.x > 0.5 ) //||sin(t) < 0.0 )\n\t\tnext = frac(next);\n\t\n\tif ( mouse.y > 0.5 ) //||sin(t) < 0.0 )\n\t\tnext *= (next);\n#endif\n\t\t\n\treturn next;\n}\n\n// --------------------------------------------------------------------------------\n\nshader_body {\n  // GLSL Sandbox mouse is 0..1, y=0 at bottom; milk3 mouse is pixels\n  float2 _sb_mouse = float2(mouse.x * texsize.z, mouse.y * texsize.w);\n  // GLSL Sandbox default surfaceSize (height=1, width=aspect)\n  float2 surfaceSize = float2(texsize.x / max(texsize.y, 1.0), 1.0);\n  // GLSL Sandbox default surface (no pan/zoom)\n  float2 _sb_surfPos = float2(\n    (uv.x - 0.5) * (texsize.x / max(texsize.y, 1.0)),\n    (uv.y - 0.5));\n\tfloat t = time;\n\t\n\tfloat2 r = texsize.xy;// - abs(surfaceSize/PI - texsize.xy/PI) * PI ;// - surfaceSize*2.0;//surfaceSize*2.0 - texsize.xy; //abs(surfaceSize - texsize.xy); // + abs(surfaceSize*texsize.xy)) / 2.0; //-;\n\t//float2 r = lerp(texsize.xy,texsize.yx,1.0-frac(t));\n\t//float2 r = TAU - (abs(surfaceSize/PI - texsize.xy/PI) * PI);// - surfaceSize*2.0;//surfaceSize*2.0 - texsize.xy; //abs(surfaceSize - texsize.xy); // + abs(surfaceSize*texsize.xy)) / 2.0; //-;\n\t\n\t//r = s2c(float3(1.0-r,time));\n\t\n\tfloat2 fc = (uv * texsize.xy); // / float2(-(uv * texsize.xy).y,(uv * texsize.xy).x);\n\t\n\t//fc /= texsize.xy;\n\n#if 0\n\tfloat2 q = surfaceSize - 2.0 * r - fc*fc; //r/(r-fc);\n\tfc += (fc*r)+q;\n#endif\n\t\n\t\n\t//float2 fc = lerp((uv * texsize.xy),(float4(uv * texsize.xy, 0, 1)).yx,frac(t));\n\t\n\t//fc *= ((TAU * TAU * TAU)/32.0);\n\t\n\t//float2 fc2 = r + (r * (r * TAU * sin(_sb_mouse.x*_sb_mouse.y*TAU+fc.x*fc.y)));\n\t\n\t//fc = fc + smoothstep(fc,fc2,frac(fc2));\n\t//if ( fc2 == r ) fc = fc2;\n\t\n\tfloat2 uvn = fc.xy/r.xy;\n\t\n\t//float4 last = tex2D(sampler_feedback,uvn);\n\tfloat2 p = ((2.0*(fc.xy) - r.xy)/r.y); // uvn * 2.0 - 1.0;//\n\tfloat2 sp = surfacePosition;//float2(-surfacePosition.y,surfacePosition.x);\n\t\n\t\n\t//p *= r.yx * cos(p * p) + r.yx * sin( sp + p);\n\t//sp *= (surfaceSize * sp) * log( -abs(texsize.xy * (texsize.xy + p * sp) ) );\n\t//sp *= sp * log(abs(sp));\n\t\n\t//sp = pow(((float2)(1.0/TAU)),sp);\n\t\n\t\n\tfloat td = 1.0/256.0;\n\t\n//\tfloat2 m = cos(t*TAU) - TAU * (_sb_mouse * 2.0 - 1.0); // TAU; // * (TAU);\n//\tfloat2 m = cos(t*PI+t) * (_sb_mouse * 2.0 - 1.0); // TAU; // * (TAU);\n\tfloat2 m = (_sb_mouse * 2.0 - 1.0); // TAU; // * (TAU);\n\tm *= TAU;\n\t\n\t//m = m * Lissajous( uvn.x * 4.0, uvn.y * 3.0, PI/2.0, dot(uvn,sp) );\n\t\n\t//if ( m.y>m.x ) p = lerp(p,p+p*fc,m.x*m.y);\n\t//if ( m.y>m.x ) p = lerp(p,p+fc,m.x*m.y);\n\t\n\t//p *= p*(texsize.xy/surfaceSize);\n\t\n\tfloat3 next = whatisoutsideapixel(sp,p,m,uvn-sp,t);\n\t//float3 nextB = whatisoutsideapixel(p,sp,m,uvn,t);\n\t//float3 nextC = whatisoutsideapixel(p,sp,m,uvn,t);\n\t//float3 nextD = whatisoutsideapixel(p,sp,m,uvn,t);\n\t\n#if 0\n\tfloat e = next.z + 1e-2*TAU;\n\tfloat3 next2 = whatisoutsideapixel(next.xy,next.yz,m,uvn,t+e);\n\tnext = next2;\n#endif\n\n#if 0\n\t\n\tnext = (next2.zyx + next);\n\t//next = lerp(reflect(next,next2),next,dot(uvn.yy,uvn.xx));\n\t//next = fwidth(next);\n\tnext = frac(next);\n\t\n#elif 0\n\t\n\tp = s2c(next);\n\tsp = s2c(next);\n\t\n\tnext = last.xyz + whatisoutsideapixel(p,sp,m,uvn,t);\n\tnext = frac(next);\n\t\n#elif 0\n\t\n\t//next *= next;\n\t//next = abs(next);\n\tnext = fwidth(next);\n\t//next = frac(next);\n\t\n#endif\n\t\n\t//next = whatisoutsideapixel(s2c(next).yx,m.yx,sp.yx,uvn,t);\n\t\n\t//next *= 1.0-log(next - prev);\n\t\n\t//next = ((float3)(dot(next,((float3)(0.66)))));\n\t\n#if 0\n\tfloat ndp = dot(next,next);\n\tfloat2 st = s2cB(next) * s2cA(1.0-1.0/(1.0+next*next));\n\tnext = frac(float3(ndp,st));\n#endif\n\t\n#if 0\n\t//next *= next;\n\tnext = cos(next * next) * next;\n\tnext = pow(((float3)(abs(4.0/next))),next);\n\tnext = frac(next);\n#endif\n\t\n\t//next *= next;\n\t//next = ((float3)(smoothstep(0.0,1.0,0.5-next)));\n\t//next *= 1.0-(step(0.5,next));\n\t\n\t//next = pow(abs(next),((float3)(abs(PI/6.0+TAU*sin(time*TAU)))));\n\t\n\t//next = ((float3)(1.0)) - next;\n\t\n\t//next = frac(exp(cos(next)));\n\t\n#if 0\n\tnext *= ((float3)(frac(dot(sp,sp)))) * 2.0 - 1.0;\n\tif ( 0.0 >= (next.x*next.y*next.z) ) next = frac(2.0 - next);\n#endif\n\t\n\tret = float4( next, 1.0 );\n\t\n\t//ret.xyz = float3(frac(m),dot(m,m));\n}\n"
