  "image": "static float PI  = 4.0*atan(1.0);\n\nstatic float3 sunLight  = normalize( float3(  0.35, 0.2,  0.3 ) );\nstatic float3 cameraPos;\nstatic float3 sunColour = float3(1.0, .75, .6);\nstatic const float2x2 rotate2D = float2x2(1.932, 1.623, -1.623, 1.95);\nstatic float gTime = 0.0;\n\n//--------------------------------------------------------------------------\n// Noise functions...\nfloat Hash( float n )\n{\n    return frac(sin(n)*43758.5453123);\n}\n\n//--------------------------------------------------------------------------\nfloat Hash(float2 p)\n{\n\treturn frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);\n}\n//----------------------------------------------------------------------\nfloat Noise( float2 x )\n{\n    float2 p = floor(x);\n    float2 f = frac(x);\n    f = f*f*(3.0-2.0*f);\n    float n = p.x + p.y*57.0;\n    float res = lerp(lerp( Hash(n+  0.0), Hash(n+  1.0),f.x),\n                    lerp( Hash(n+ 57.0), Hash(n+ 58.0),f.x),f.y);\n    return res;\n}\n\nfloat2 Voronoi( float2 x )\n{\n\tfloat2 p = floor( x );\n\tfloat2 f = frac( x );\n\tfloat res=100.0,id;\n\tfor( int j=-1; j<=1; j++ )\n\tfor( int i=-1; i<=1; i++ )\n\t{\n\t\tfloat2 b = float2( float(i), float(j) );\n\t\tfloat2 r = ((float2)(b)) - f  + Hash( p + b );\n\t\tfloat d = dot(r,r);\n\t\tif( d < res )\n\t\t{\n\t\t\tres = d;\n\t\t\tid  = Hash(p+b);\n\t\t}\t\t\t\n    }\n\treturn float2(max(.4-sqrt(res), 0.0),id);\n}\n\n\n//--------------------------------------------------------------------------\nfloat2 Terrain( float2 p)\n{\n\tfloat type = 0.0;\n\tfloat2 pos = p*0.003;\n\tfloat w = 50.0;\n\tfloat f = .0;\n\tfor (int i = 0; i < 3; i++)\n\t{\n\t\tf += Noise(pos) * w;\n\t\tw = w * 0.62;\n\t\tpos *= 2.5;\n\t}\n\n\treturn float2(f, type);\n}\n\n//--------------------------------------------------------------------------\nfloat2 Map(float3 p)\n{\n\tfloat2 h = Terrain(p.xz);\n    return float2(p.y - h.x, h.y);\n}\n\n//--------------------------------------------------------------------------\nfloat FractalNoise(float2 xy)\n{\n\tfloat w = .7;\n\tfloat f = 0.0;\n\n\tfor (int i = 0; i < 3; i++)\n\t{\n\t\tf += Noise(xy) * w;\n\t\tw = w*0.6;\n\t\txy = 2.0 * xy;\n\t}\n\treturn f;\n}\n\n//--------------------------------------------------------------------------\n// Grab all sky information for a given ray from camera\nfloat3 GetSky(float3 rd)\n{\n\tfloat sunAmount = max( dot( rd, sunLight), 0.0 );\n\tfloat v = pow(1.0-max(rd.y,0.0),6.);\n\tfloat3  sky = lerp(float3(.1, .2, .3), ((float3)(.32)), v);\n\tsky = sky + sunColour * sunAmount * sunAmount * .25;\n\tsky = sky + sunColour * min(pow(sunAmount, 800.0)*1.5, .3);\n\treturn clamp(sky, 0.0, 1.0);\n}\n\n//--------------------------------------------------------------------------\n// Merge grass into the sky background for correct fog colouring...\nfloat3 ApplyFog( float3  rgb, float dis, float3 dir)\n{\n\tfloat fogAmount = clamp(dis*dis* 0.0000012, 0.0, 1.0);\n\treturn lerp( rgb, GetSky(dir), fogAmount );\n}\n\n//--------------------------------------------------------------------------\nfloat3 DE(float3 p)\n{\n\tfloat base = Terrain(p.xz).x - 1.9;\n\tfloat height = Noise(p.xz*2.0)*.75 + Noise(p.xz)*.35 + Noise(p.xz*.5)*.2;\n\t//p.y += height;\n\tfloat y = p.y - base-height;\n\ty = y*y;\n\tfloat2 ret = Voronoi((p.xz*2.5+sin(y*4.0+p.zx*12.3)*.12+float2(sin(time*2.3+1.5*p.z),sin(time*3.6+1.5*p.x))*y*.5));\n\tfloat f = ret.x * .6 + y * .58;\n\treturn float3( y - f*1.4, clamp(f * 1.5, 0.0, 1.0), ret.y);\n}\n\n//--------------------------------------------------------------------------\n// eiffie's code for calculating the aperture size for a given hitDist...\nfloat CircleOfConfusion(float t)\n{\n\treturn max(t * .04, (2.0 / texsize.y) * (1.0+t));\n}\n\n//--------------------------------------------------------------------------\nfloat Linstep(float a, float b, float t)\n{\n\treturn clamp((t-a)/(b-a),0.,1.);\n}\n\n//--------------------------------------------------------------------------\nfloat3 GrassBlades(float3 rO, float3 rD, float3 mat, float dist)\n{\n\tfloat d = 0.0;\n\tfloat f;\n\t// Only calculate cCoC once is enough here...\n\tfloat rCoC = CircleOfConfusion(dist*.3);\n\tfloat alpha = 0.0;\n\t\n\tfloat4 col = float4(mat*0.15, 0.0);\n\n\tfor (int i = 0; i < 15; i++)\n\t{\n\t\tif (col.w > .99) break;\n\t\tfloat3 p = rO + rD * d;\n\t\t\n\t\tfloat3 ret = DE(p);\n\t\tret.x += .5 * rCoC;\n\n\t\tif (ret.x < rCoC)\n\t\t{\n\t\t\talpha = (1.0 - col.y) * Linstep(-rCoC, rCoC, -ret.x);//calculate the lerp like cloud density\n\t\t\tf = clamp(ret.y, 0.0, 1.0);\n\t\t\t// Mix material with white tips for grass...\n\t\t\tfloat3 gra = lerp(mat, float3(.35, .35, min(pow(ret.z, 4.0)*35.0, .35)), pow(ret.y, 9.0)*.7) * ret.y;\n\t\t\tcol += float4(gra * alpha, alpha);\n\t\t}\n\t\td += max(ret.x * .7, .1);\n\t}\n\tif(col.w < .2)\n\t\tcol.xyz = float3(0.1, .15, 0.05);\n\treturn col.xyz;\n}\n\n//--------------------------------------------------------------------------\n// Calculate sun light...\nvoid DoLighting(inout float3 mat, float3 pos, float3 normal, float3 eyeDir, float dis)\n{\n\tfloat h = dot(sunLight,normal);\n\tmat = mat * sunColour*(max(h, 0.0)+.2);\n}\n\n//--------------------------------------------------------------------------\nfloat3 TerrainColour(float3 pos, float3 dir,  float3 normal, float dis, float type)\n{\n\tfloat3 mat;\n\tif (type == 0.0)\n\t{\n\t\t// Random colour...\n\t\tmat = lerp(float3(.0,.3,.0), float3(.2,.3,.0), Noise(pos.xz*.025));\n\t\t// Random shadows...\n\t\tfloat t = FractalNoise(pos.xz * .1)+.5;\n\t\t// Do grass blade tracing...\n\t\tmat = GrassBlades(pos, dir, mat, dis) * t;\n\t\tDoLighting(mat, pos, normal,dir, dis);\n\t}\n\tmat = ApplyFog(mat, dis, dir);\n\treturn mat;\n}\n\n//--------------------------------------------------------------------------\n// Home in on the surface by dividing by two and split...\nfloat BinarySubdivision(float3 rO, float3 rD, float t, float oldT)\n{\n\tfloat halfwayT = 0.0;\n\tfor (int n = 0; n < 5; n++)\n\t{\n\t\thalfwayT = (oldT + t ) * .5;\n\t\tif (Map(rO + halfwayT*rD).x < .05)\n\t\t{\n\t\t\tt = halfwayT;\n\t\t}else\n\t\t{\n\t\t\toldT = halfwayT;\n\t\t}\n\t}\n\treturn t;\n}\n\n//--------------------------------------------------------------------------\nbool Scene(float3 rO, float3 rD, out float resT, out float type )\n{\n    float t = 5.;\n\tfloat oldT = 0.0;\n\tfloat delta = 0.;\n\tfloat2 h = ((float2)(1.0));\n\tbool hit = false;\n\tfor( int j=0; j < 80; j++ )\n\t{\n\t    float3 p = rO + t*rD;\n\t\tif (p.y < 105.0 && !hit)\n\t\t{\n\t\t\th = Map(p); // ...Get this position's height mapping.\n\t\n\t\t\t// Are we inside, and close enough to fudge a hit?...\n\t\t\tif( h.x < 0.05)\n\t\t\t{\n\t\t\t\t// Yes! So home in on height map...\n\t\t\t\tresT = BinarySubdivision(rO, rD, t, oldT);\n\t\t\t\ttype = h.y;\n\t\t\t\thit = true;\n\t\t\t}else\n\t\t\t{\n\t\t\t\t// Delta ray advance - a fudge between the height returned\n\t\t\t\t// and the hitDist already travelled.\n\t\t\t\t// Compromise between speed and accuracy...\n\t\t\t\tdelta = max(0.04, 0.35*h.x) + (t*0.04);\n\t\t\t\toldT = t;\n\t\t\t\tt += delta;\n\t\t\t}\n\t\t}\n\t}\n\n\treturn hit;\n}\n\n//--------------------------------------------------------------------------\nfloat3 CameraPath( float t )\n{\n\t//t = time + t;\n    float2 p = float2(200.0 * sin(3.54*t), 200.0 * cos(2.0*t) );\n\treturn float3(p.x+55.0,  12.0+sin(t*.3)*6.5, -94.0+p.y);\n} \n\n//--------------------------------------------------------------------------\nfloat3 PostEffects(float3 rgb, float2 xy)\n{\n\t// Gamma first...\n\trgb = pow(rgb, ((float3)(0.45)));\n\t\n\t// Then...\n\t#define CONTRAST 1.1\n\t#define SATURATION 1.3\n\t#define BRIGHTNESS 1.3\n\trgb = lerp(((float3)(.5)), lerp(((float3)(dot(float3(.2125, .7154, .0721), rgb*BRIGHTNESS))), rgb*BRIGHTNESS, SATURATION), CONTRAST);\n\t// Vignette...\n\trgb *= .4+0.5*pow(40.0*xy.x*xy.y*(1.0-xy.x)*(1.0-xy.y), 0.2 );\t\n\treturn rgb;\n}\n\n//--------------------------------------------------------------------------\n\nshader_body {\n  // GLSL Sandbox mouse is 0..1, y=0 at bottom; milk3 mouse is pixels, y=0 at top\n  float2 _sb_mouse = float2(mouse.x * texsize.z, mouse.y * texsize.w);\n\tfloat m = (_sb_mouse.x/texsize.x)*300.0;\n\tfloat gTime = (time*5.0+m+2352.0)*.006;\n    float2 xy = (uv * texsize.xy) / texsize.xy;\n\tfloat2 uvn = (-1.0 + 2.0 * xy) * float2(texsize.x/texsize.y,1.0);\n\tfloat3 camTar;\n\t\n\tif (xy.y < .13 || xy.y >= .87)\n\t{\n\t\t// Top and bottom cine-crop - what a waste! :)\n\t\tret=((float4)(0.0));\n\t\t_return_value = float4(ret.xyz, 1.0); return;\n\t}\n\n\t#ifdef STEREO\n\tfloat isCyan = fmod((uv * texsize.xy).x + fmod((uv * texsize.xy).y,2.0),2.0);\n\t#endif\n\n\tcameraPos = CameraPath(gTime + 0.0);\n\tcamTar\t = CameraPath(gTime + .009);\n\tcameraPos.y += Terrain(CameraPath(gTime + .009).xz).x;\n\tcamTar.y = cameraPos.y;\n\t\n\tfloat roll = .4*sin(gTime+.5);\n\tfloat3 cw = normalize(camTar-cameraPos);\n\tfloat3 cp = float3(sin(roll), cos(roll),0.0);\n\tfloat3 cu = cross(cw,cp);\n\tfloat3 cv = cross(cu,cw);\n\tfloat3 dir = normalize(uvn.x*cu + uvn.y*cv + 1.3*cw);\n\tfloat3x3 camMat = float3x3(cu, cv, cw);\n\n\t#ifdef STEREO\n\tcameraPos += .85*cu*isCyan; // move camera to the right - the rd vector is still good\n\t#endif\n\n\tfloat3 col;\n\tfloat hitDist;\n\tfloat type;\n\tif( !Scene(cameraPos, dir, hitDist, type) )\n\t{\n\t\t// Missed scene, now just get the sky...\n\t\tcol = GetSky(dir);\n\t}\n\telse\n\t{\n\t\t// Get world coordinate of landscape...\n\t\tfloat3 pos = cameraPos + hitDist * dir;\n\t\t// Get normal from sampling the high definition height map\n\t\t// Use the hitDist to sample larger gaps to help stop aliasing...\n\t\tfloat2 p = float2(0.1, 0.0);\n\t\tfloat3 nor  \t= float3(0.0,\t\tTerrain(pos.xz).x, 0.0);\n\t\tfloat3 v2\t\t= nor-float3(p.x,\tTerrain(pos.xz+p).x, 0.0);\n\t\tfloat3 v3\t\t= nor-float3(0.0,\tTerrain(pos.xz-p.yx).x, -p.x);\n\t\tnor = cross(v2, v3);\n\t\tnor = normalize(nor);\n\n\t\t// Get the colour using all available data...\n\t\tcol = TerrainColour(pos, dir, nor, hitDist, type);\n\t}\n\t\n\t// bri is the brightness of sun at the centre of the camera direction.\n\t// Yeah, the lens flares is not exactly subtle, but it was good fun making it.\n\tfloat bri = dot(cw, sunLight)*.75;\n\tif (bri > 0.0)\n\t{\n\t\tfloat2 sunPos = float2( dot( sunLight, cu ), dot( sunLight, cv ) );\n\t\tfloat2 uvT = uvn-sunPos;\n\t\tuvT = uvT*(length(uvT));\n\t\tbri = pow(bri, 6.0)*.8;\n\n\t\t// glare = the red shifted blob...\n\t\tfloat glare1 = max(dot(normalize(float3(dir.x, dir.y+.3, dir.z)),sunLight),0.0)*1.4;\n\t\t// glare2 is the yellow ring...\n\t\tfloat glare2 = max(1.0-length(uvT+sunPos*.5)*4.0, 0.0);\n\t\tuvT = lerp (uvT, uvn, -2.3);\n\t\t// glare3 is a purple splodge...\n\t\tfloat glare3 = max(1.0-length(uvT+sunPos*5.0)*1.2, 0.0);\n\n\t\tcol += bri * float3(1.0, .0, .0)  * pow(glare1, 12.5)*.05;\n\t\tcol += bri * float3(1.0, 1.0, 0.2) * pow(glare2, 2.0)*2.5;\n\t\tcol += bri * sunColour * pow(glare3, 2.0)*3.0;\n\t}\n\tcol = PostEffects(col, xy);\t\n\t\n\t#ifdef STEREO\t\n\tcol *= float3( isCyan, 1.0-isCyan, 1.0-isCyan );\t\n\t#endif\n\t\n\tret=float4(col,1.0);\n}\n"
}
